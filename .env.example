# Copy to .env (git-ignored). `adk web` and `adk run` load it automatically.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_API_KEY=your-key-from-aistudio.google.com

# demo (bundled files) or google (your Workspace)
RISK_AGENT_BACKEND=demo
# RISK_AGENT_SHEET_IDS=...
# RISK_AGENT_DOC_IDS=...
# GOOGLE_APPLICATION_CREDENTIALS=/path/outside/the/repo/risk-agent-reader.json

# Pin "today" so answers about the demo data stay reproducible.
RISK_AGENT_TODAY=2026-10-13
